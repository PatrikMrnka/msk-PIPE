% Příklad konfigurace pro MuscleMap integraci
% Přidejte či aktualizujte tyto sekce v config.json nebo config/user_settings.yaml

# Nastavení pro segmentaci svalů (muscle_preproc)
muscle_preproc:
  min_voxels: 100              # Minimální počet voxelů pro zachování svalu
  opening_kernel: 3            # Velikost kernelu pro morfologické otevření
  closing_kernel: 3            # Velikost kernelu pro morfologické zavření
  fill_holes: true             # Vyplnit malé díry v masce
  keep_largest: true           # Zachovat pouze největší komponentu

# Nastavení pro konverzi do mesh formátů (mask_to_mesh)
mask_to_mesh:
  smooth_iterations: 50        # Pro kostí (STL)
  # Pro svaly: 30 iterací (OBJ) je nastaveno v Snakefile

# Typické workflow pro muscle segmentaci:
# 1. load_image           -> načítá CT/MRI do NIfTI
# 2. muscle_map_raw      -> spouští MuscleMap (mm_segment)
# 3. clean_muscle_masks  -> čistí masky
# 4. cpp_muscle_mask2obj -> konvertuje masky do .obj modelů

# Výstupní struktura:
# data/temp/
#   ├── muscle_segmentations_raw/    <- Raw MuscleMap output
#   ├── muscle_segmentations/        <- Čištěné svaly (.nii.gz)
#   └── muscle_models/               <- OBJ modely svalů

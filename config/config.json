{
    "paths": {
        "input_dir": "data/input",
        "temp_dir": "data/temp",
        "output_dir": "data/output"
    },
    "snakemake_env": {
        "totalseg": "env_totalseg_gpu.yaml",
        "musclemap": "env_musclemap_gpu.yaml"
    },
    "totalsegmentator": {
        "fast": false,
        "device": "gpu",
        "model": "ct"
    },
    "mask_preproc": {
        "min_voxels": 20000,
        "opening_kernel": 2,
        "closing_kernel": 2,
        "fill_holes": true,
        "keep_largest": true,
        "inplace": true
    },
    "mask_to_mesh": {
        "smooth_iterations": 50,
        "relax_factor": 0.2,
        "decimate_fraction": 0.1
    },
    "muscle_map": {
        "default_model": "default",
        "labels": {
            "adductor_brevis_l": 7221,
            "adductor_brevis_r": 7222,
            "gluteus_medius_l": 6111,
            "gluteus_medius_r": 6112,
            "gluteus_maximus_l": 6121,
            "gluteus_maximus_r": 6122,
            "iliacus_l": 6141,
            "iliacus_r": 6142
        }
    },
    "muscle_preproc": {
        "min_voxels": 100,
        "opening_kernel": 3,
        "closing_kernel": 3,
        "fill_holes": true,
        "keep_largest": true
    }
}
)

# ---------------------------------------------------------------------------
# Mapping from TotalSegmentator bone names → STAPLE-compatible mesh names.
# Used by the rename_bones_for_staple rule.
# Key: substring that must appear in the filename (lowercase).
# Value: STAPLE base name (side suffix _l/_r is appended automatically).
# ---------------------------------------------------------------------------
STAPLE_NAME_MAP = {
    "pelvis": "pelvis_no_sacrum",  # pelvis has no side suffix
    "femur": "femur",
    "tibia": "tibia",
    "fibula": "fibula",
    "talus": "talus",
    "calcaneus": "calcn",
    "calcn": "calcn",
    "toes": "toes",
    "metatarsals": "toes",
}
STAPLE_SIDELESS = {"pelvis_no_sacrum"}  # names that never get a side suffix


def determine_run_id(base_out_dir):
    """
    Determines the appropriate RUN_ID based on existing runs in the output directory.
    If no runs exist, it returns "run_1". If runs exist, it checks the latest run for the presence of the final output file (pipeline_model.osim).
    If the final output exists, it increments the run number; if not, it returns the latest run ID to allow Snakemake to resume.
    """
    if not os.path.exists(base_out_dir):
        return "run_1"

    # find existing runs in the output directory
    existing_runs = []
    for d in os.listdir(base_out_dir):
        if d.startswith("run_") and os.path.isdir(os.path.join(base_out_dir, d)):
            try:
                num = int(d.split("_")[1])
                existing_runs.append(num)
            except ValueError:
                continue

    if not existing_runs:
        return "run_1"

    latest_num = max(existing_runs)
    latest_run = f"run_{latest_num}"

    # is the final output from the latest run present?
    final_target = os.path.join(base_out_dir, latest_run, "pipeline_model.osim")

    if os.path.exists(final_target):
        # successfully completed run exists, start a new one
        return f"run_{latest_num+1}"
    else:
        # latest run is incomplete, resume it
        return latest_run


RUN_ID = determine_run_id(BASE_OUT_DIR)
OUT_DIR = os.path.join(BASE_OUT_DIR, RUN_ID)
os.makedirs(OUT_DIR, exist_ok=True)

########################################################################################
# Detecting input format and files

INPUT_FORMAT = config.get("input_format", "auto").lower()
INPUT_TYPE = None
INPUT_FILES = {}

in_dir_path = Path(IN_DIR)

if INPUT_FORMAT in ["auto", "nifti"]:
    nii_files = list(in_dir_path.rglob("*.nii.gz")) + list(in_dir_path.rglob("*.nii"))
    if nii_files:
        INPUT_TYPE = "nifti"
        INPUT_FILES["nii"] = str(nii_files[0])

# 2. Jsou na vstupu RAW data?
if not INPUT_TYPE and INPUT_FORMAT in ["auto", "raw"]:
    raw_files = list(in_dir_path.rglob("*.raw"))
    if raw_files:
        raw_file = raw_files[0]
        # Hledání coordinates.txt
        coords_files = list(raw_file.parent.glob("coordinates.txt")) or list(
            in_dir_path.rglob("coordinates.txt")
        )
        if not coords_files:
            sys.exit(f"[ERROR] Nalezen RAW, ale chybí coordinates.txt pro {raw_file}")

        INPUT_TYPE = "raw"
        INPUT_FILES["raw"] = str(raw_file)
        INPUT_FILES["coords"] = str(coords_files[0])

# 3. Jsou na vstupu DICOMy?
if not INPUT_TYPE and INPUT_FORMAT in ["auto", "dicom"]:
    # Nejprve zkusíme rovnou příponu .dcm
    dcm_files = list(in_dir_path.rglob("*.dcm"))
    if dcm_files:
        INPUT_TYPE = "dicom"
        INPUT_FILES["dicom_dir"] = str(dcm_files[0].parent)
    else:
        # Záchyt pro DICOMy bez přípony (nesmí to být coordinates.txt)
        for d in [in_dir_path] + [sub for sub in in_dir_path.iterdir() if sub.is_dir()]:
            has_dicom = any(
                f.is_file() and f.suffix == "" and f.name.lower() != "coordinates.txt"
                for f in d.iterdir()
            )
            if has_dicom:
                INPUT_TYPE = "dicom"
                INPUT_FILES["dicom_dir"] = str(d)
                break

# Kontrola, zda jsme něco našli
if not INPUT_TYPE:
    sys.exit(
        f"[ERROR] Nebyly nalezeny žádné vstupní soubory pro formát '{INPUT_FORMAT}' ve složce {IN_DIR}."
    )

########################################################################################


# help func for getting the right python executable for each step
def get_py_exe(env_name):

    exe = (
        f"envs/{env_name}/python.exe"
        if os.name == "nt"
        else f"envs/{env_name}/bin/python"
    )
    return os.path.normpath(exe)



            .get(Path(INPUT_FILES["raw"]).name, {})
            .get("dimensions", "512x512x120"),
        shell:
            """
            "{params.py_exe}" src/python/converting_formats/CT_raw_to_nifti.py \
                "{input.raw}" "{input.coords}" -o "{output.nii}" --shape {params.dims}
            """


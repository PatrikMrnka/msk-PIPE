        seg_dir=directory(os.path.join(OUT_DIR, "muscle_segmentations", "cleaned")),
    params:
        py_exe=lambda wildcards: get_py_exe(
            config["snakemake_env"]["totalseg"]
            .replace("env_", "msk_")
            .replace(".yaml", "")
        ),
        min_v=config.get("muscle_preprocessing", {}).get("min_voxels", 100),
        open_k=config.get("muscle_preprocessing", {}).get("opening_kernel", 3),
        clos_k=config.get("muscle_preprocessing", {}).get("closing_kernel", 3),
        holes=(
            "--fill-holes"
            if config.get("muscle_preproc", {}).get("fill_holes", True)
            else "--no-fill-holes"
        ),
        keep_l=(
            "--keep-largest"
            if config.get("muscle_preproc", {}).get("keep_largest", True)
            else "--no-keep-largest"
        ),
    shell:
        """
        "{params.py_exe}" src/python/clean_masks.py \
            --input-dir {input.seg_raw_dir} \
            --output-dir {output.seg_dir} \
            --iso 0.5 \
            --min-voxels {params.min_v} \
            --opening {params.open_k} \
            --closing {params.clos_k} \
            {params.holes} \
            {params.keep_l}
        """



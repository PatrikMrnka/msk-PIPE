# 5. STEP - CONVERTING MASKS TO MESHES


# 5a - bones: convert cleaned NIfTI masks → STL meshes (names kept as-is)
rule bone_mask_to_stl:
    input:
        seg_dir=os.path.join(OUT_DIR, "bone_segmentations", "cleaned"),
    output:
        models_dir=directory(os.path.join(OUT_DIR, "bone_models")),
    params:
        cpp_bin="src/cpp/mask_to_mesh/Build/Release/mask_to_mesh.exe",
        smooth=config.get("bone_to_mesh", {}).get("smooth_iterations", 30),
        passband=config.get("bone_to_mesh", {}).get("passband", 0.01),
    shell:
        """
        "{params.cpp_bin}" \
            --input-dir  {input.seg_dir} \
            --output-dir {output.models_dir} \
            --smooth_iters {params.smooth} \
            --passband {params.passband} \
            --format stl
        """


# 5a' - rename bone STLs to STAPLE-compatible names (e.g. femur_left → femur_l)
#        Logic moved here from C++ so the mapping is visible in the workflow.
rule rename_bones_for_staple:
    input:
        models_dir=os.path.join(OUT_DIR, "bone_models"),
    output:
        renamed_dir=directory(os.path.join(OUT_DIR, "bone_models_renamed")),
    run:
        import shutil

        os.makedirs(output.renamed_dir, exist_ok=True)

        def staple_name(stem: str) -> str:
            """Map a TotalSegmentator bone stem to its STAPLE-compatible name."""
            s = stem.lower()
            # Detect anatomical side
            if "left" in s or s.endswith("_l") or "_left_" in s:
                side = "_l"
            elif "right" in s or s.endswith("_r") or "_right_" in s:
                side = "_r"
            else:
                side = ""
            # Match against the name map
            for keyword, staple_base in STAPLE_NAME_MAP.items():
                if keyword in s:
                    if staple_base in STAPLE_SIDELESS:
                        return staple_base  # no side suffix
                    return staple_base + side  # e.g. femur_l
            return stem  # unrecognised: keep original name

        for src in Path(input.models_dir).glob("*.stl"):
            new_name = staple_name(src.stem) + ".stl"
            dst = Path(output.renamed_dir) / new_name
            print(f"[rename] {src.name} → {new_name}")
            shutil.copy2(src, dst)



# 5b - muscles: convert cleaned NIfTI masks → OBJ meshes
rule muscle_mask_to_obj:
    input:
        seg_dir=os.path.join(OUT_DIR, "muscle_segmentations", "cleaned"),
    output:
        models_dir=directory(os.path.join(OUT_DIR, "muscle_models")),
    params:
        cpp_bin="src/cpp/mask_to_mesh/Build/Release/mask_to_mesh.exe",
        smooth=config.get("muscle_to_mesh", {}).get("smooth_iterations", 30),
        passband=config.get("muscle_to_mesh", {}).get("passband", 0.005),
    shell:
        """
        "{params.cpp_bin}" \
            --input-dir  {input.seg_dir} \
            --output-dir {output.models_dir} \
            --smooth_iters {params.smooth} \
            --passband {params.passband} \
            --format obj
        """



# 9. STEP - RUNNING MUSCLE WRAPPING


rule run_muscle_wrapping:
    input:
        xml=os.path.join(OUT_DIR, "setup_MuscleGeneratorTool.xml"),
    output:
        osim=os.path.join(OUT_DIR, "pipeline_model.osim"),
    params:
        workdir=OUT_DIR,
        opensim=Path(MW_PATH_DIR, "Bin", "opensim-cmd.exe").resolve(),
        dll=Path(MW_PATH_DIR, "Bin", "OsimMuscleGeneratorTool.dll").resolve(),
    shell:
        r"""
        "{params.opensim}" -L "{params.dll}" run-tool "{input.xml}"
        """



# 6. STEP - MERGING AND PROCESSING MESHES, PREPARING FOR STAPLE


# 6a - merging STAPLE-renamed bone meshes into a single directory for STAPLE
rule merge_meshes:
    input:
        models_dir=os.path.join(OUT_DIR, "bone_models_renamed"),
    output:
        meshes_dir=directory(os.path.join(OUT_DIR, "bone_models_merged")),
    params:
        py_exe=get_py_exe("msk_base"),
    shell:
        """
        "{params.py_exe}" src/python/merge_meshes.py \
            --input-dir  {input.models_dir} \
            --output-dir {output.meshes_dir}
        """


# 6b - running STAPLE for generating the final .osinm model
rule msk_staple:
    input:
        mesh_dir=os.path.join(OUT_DIR, "bone_models_merged"),
        matlab_script="src/python/staple_processing/hip_model.m",
    output:
        osim=os.path.join(OUT_DIR, "bone_model.osim"),
        geom_dir=directory(os.path.join(OUT_DIR, "Geometry")),
    params:
        py_exe=get_py_exe("msk_base"),
        staple_path=config.get("paths", {}).get("staple_path"),
    shell:
        """
        "{params.py_exe}" src/python/staple_processing/process_staple.py \
            --input-dir "{input.mesh_dir}" \
            --output-osim "{output.osim}" \
            --output-geom-dir "{output.geom_dir}" \
            --staple-path "{params.staple_path}" \
            --matlab-script "{input.matlab_script}"
        """



# Snakefile -- MSK Pipeline orchestrator.
#
# This file is intentionally minimal.  All logic lives in the rule modules
# under workflow/rules/.  Configuration is loaded from config/config.json
# and augmented at runtime by runner/pipeline.py (which passes run_id and
# optional input_path via --config).


configfile: "config/config.json"


# Shared constants, helpers, and derived paths.
include: "rules/common.smk"
# Step 0: Input detection and normalisation (NIfTI / RAW / DICOM).
include: "rules/input.smk"
# Steps 1-3: Bone and muscle segmentation + muscle mask extraction.
include: "rules/segmentation.smk"
# Step 4: Per-file mask cleaning (bones and muscles).
include: "rules/preprocessing.smk"
# Steps 5-6: Mask-to-mesh conversion, STAPLE renaming, mesh merging.
include: "rules/meshing.smk"
# Steps 7-10: STAPLE modelling, attachment extraction, muscle wrapping.
include: "rules/modeling.smk"
# Step 11: Post-run statistics (PIPELINE vs selected LHDL reference).
include: "rules/statistics.smk"


# ---------------------------------------------------------------------------
# Final target: the complete pipeline output.
# ---------------------------------------------------------------------------


rule all:
    input:
        os.path.join(OUT_DIR, "bone_model.osim"),
        os.path.join(OUT_DIR, "muscle_models", ".done"),
        os.path.join(OUT_DIR, "setup_MuscleGeneratorTool.xml"),
        os.path.join(OUT_DIR, "pipeline_model.osim"),
        os.path.join(OUT_DIR, "statistics", ".done"),
        os.path.join(OUT_DIR, "statistics", "Kinematika_Report.pdf"),  # Vyžádá generování PDF
        os.path.join(OUT_DIR, "statistics", "Celkove_Statistiky_s_Procenty.csv"), # Vyžádá CSV
        (os.path.join(OUT_DIR, "statistics", "Benchmark_Report.pdf") if config.get("user_settings", {}).get("enable_benchmarking", True) else []),
        # expand(os.path.join(OUT_DIR, "VTK", "{muscle}.vtk"), muscle=MUSCLES),
        # expand(os.path.join(OUT_DIR, "VTK", "{bone}.vtk"), bone=BONE_MASKS)
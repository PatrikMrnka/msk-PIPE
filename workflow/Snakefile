import os
from pathlib import Path


# Načtení konfigurací uložených z runner.py
configfile: "config/config.json"
configfile: "config/user_settings.yaml"


# Definice základních adresářů pomocí globálního konfigu
IN_DIR = config.get("paths", {}).get("input_dir", "data/input")
TEMP_DIR = config.get("paths", {}).get("temp_dir", "data/temp")
OUT_DIR = config.get("paths", {}).get("output_dir", "data/output")


def get_py_exe(env_name):
    import os

    exe = (
        f"envs/{env_name}/python.exe"
        if os.name == "nt"
        else f"envs/{env_name}/bin/python"
    )
    return os.path.normpath(exe)


# Vychozi cil - vysledny OSIM model z MS Muscle Wrapping
rule all:
    input:
        os.path.join(TEMP_DIR, "output_STAPLE", "bone_model.osim"),
        os.path.join(TEMP_DIR, "muscle_models"),



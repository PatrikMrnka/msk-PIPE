<OpenSimDocument Version="20302">
  <MuscleGeneratorTool name="GenericFemale_WCB_MGT">

    <!--Name of the .osim file used to construct a model.-->
    <model_file>GenericFemale_WCB.osim</model_file>

    <!-- Name of the .mot file used to fuse motion to the model. -->
    <motion_file>hip_flexion_kinematics.mot</motion_file> --> 

    <!--Name of the .osim file where to store the output model with generated dynamic muscles.-->
    <output_model_file>GenericFemale_WCB_Flex.osim</output_model_file>
    <!-- <export_folder>../Experiments/LHDL</export_folder> -->
    <output_muscle_analysis_file_prefix>C:\msk_pipe\data\DATA_LHDL\Experiments\</output_muscle_analysis_file_prefix>

    <MuscleGeneratorSet>
      <objects>
	  		<MuscleGenerator name="Iliacus">
			<!-- The description of the geometry of this muscle in the rest-pose position. Note, the rest-pose must be the first position in the motion file. -->
			<MuscleGeometry>
			  <body>pelvis</body>
			  <Mesh name="Iliacus">
				<!--Scale factors in X, Y, Z directions respectively.-->
				<scale_factors>0.001 0.001 0.001</scale_factors>
				<!--Name of geometry file.-->
				<mesh_file>muscles/iliacus_r/Iliacus.obj</mesh_file>
			  </Mesh>
  
			  <!--The origin and insertion attachment areas for this muscle-->
			  <attachment_areas>
				<AttachmentArea name="origin Ilium">
				  <type>origin</type>
				  <body>pelvis</body>
				  <point_file>muscles/iliacus_r/Iliacus_Ori.vtk</point_file>
					<!--Scale factors in X, Y, Z directions respectively.-->
					<scale_factors>0.001 0.001 0.001</scale_factors>
				</AttachmentArea>
  
				<AttachmentArea name="insertion Femur">
				  <type>insertion</type>
				  <body>femur_r</body>
				  <point_file>muscles/iliacus_r/Iliacus_Ins.vtk</point_file>
					<!--Scale factors in X, Y, Z directions respectively.-->
					<scale_factors>0.001 0.001 0.001</scale_factors>
				</AttachmentArea>
			  </attachment_areas>
			</MuscleGeometry>
  
			<!-- Fibre template to use: parallel, fanned, curved, pennate, rectus - CURRENTLY IGNORED -->
			<fiber_template> parallel </fiber_template>
			<!-- Fiber template sampling mode: uniform, random -->
			<fiber_arrangement> uniform </fiber_arrangement>
			<!-- How many geometry paths will be created from the volume -->
			<num_of_lines> 100 </num_of_lines> 
			<line_res> 15 </line_res>
		</MuscleGenerator>
	  <MuscleGenerator name="GluteusMaximus">
			<!-- The description of the geometry of this muscle in the rest-pose position. Note, the rest-pose must be the first position in the motion file. -->
			<MuscleGeometry>
			  <body>pelvis</body>
			  <Mesh name="GluteusMaximus">
					<!--Scale factors in X, Y, Z directions respectively.-->
					<scale_factors>0.001 0.001 0.001</scale_factors>
					<!--Name of geometry file.-->
				<mesh_file>muscles/gluteus_maximus_r/GluteusMaximus.obj</mesh_file>
			  </Mesh>
  
			  <!--The origin and insertion attachment areas for this muscle-->
			  <attachment_areas>
				<AttachmentArea name="origin Iliacus">
				  <type>origin</type>
				  <body>pelvis</body>
				  <point_file>muscles/gluteus_maximus_r/GluteusMaximus_Ori.vtk</point_file>
					<!--Scale factors in X, Y, Z directions respectively.-->
					<scale_factors>0.001 0.001 0.001</scale_factors>
				</AttachmentArea>
  
				<AttachmentArea name="insertion Femur">
				  <type>insertion</type>
				  <body>femur_r</body>
				  <point_file>muscles/gluteus_maximus_r/GluteusMaximus_Ins.vtk</point_file>
					<!--Scale factors in X, Y, Z directions respectively.-->
					<scale_factors>0.001 0.001 0.001</scale_factors>
				</AttachmentArea>
			  </attachment_areas>
			</MuscleGeometry>
  
			<!-- Fibre template to use: parallel, fanned, curved, pennate, rectus - CURRENTLY IGNORED -->
			<fiber_template> parallel </fiber_template>
			<!-- Fiber template sampling mode: uniform, random -->
			<fiber_arrangement> uniform </fiber_arrangement>
			<!-- How many geometry paths will be created from the volume -->
			<num_of_lines> 100 </num_of_lines> 
			<line_res> 15 </line_res>
		</MuscleGenerator>
	  </objects>
      <groups/>
    </MuscleGeneratorSet>

